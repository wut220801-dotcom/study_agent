# 复制成 .env 后按需修改。变量优先级高于同名的标准变量。

# 用哪个 provider：anthropic | openai | mock
# mock 是演示模式，不联网、不需要 key，用桩数据把整个界面和流程跑通。
LEARN_AGENT_PROVIDER=mock

# --- 真实模式需要下面这些 ---

# API key。也可以直接用 ANTHROPIC_API_KEY / OPENAI_API_KEY。
# LEARN_AGENT_API_KEY=sk-...

# 模型名。留空则用默认值（anthropic 为 claude-sonnet-4-5，openai 为 gpt-4o）。
# LEARN_AGENT_MODEL=claude-sonnet-4-5

# 走 OpenAI 兼容的第三方服务时填它的地址（DeepSeek / Moonshot / Qwen / vLLM 等）。
# LEARN_AGENT_BASE_URL=https://api.deepseek.com/v1

# 关掉 prompt cache 标记。OpenAI 官方接口不需要；某些兼容服务不认这个扩展时设为 off。
# LEARN_AGENT_CACHING=off

# --- 其他 ---

# 学习数据的存放位置。默认是项目下的 workspace/。
# LEARN_AGENT_WORKSPACE=./workspace

# 后端端口。默认 8787。
# LEARN_AGENT_PORT=8787

# 单个模型的上下文窗口。压缩阈值由它推导——用第三方模型时记得改成实际值。
# LEARN_AGENT_CONTEXT_WINDOW=200000

# 一轮对话允许的最大工具调用轮次。默认 40。
# LEARN_AGENT_MAX_ITERATIONS=40

# 推理强度（thinking）。off | low | high | max
# 规划师做的是拆大纲、排依赖这类多步推理，导师多数时候是在讲解已想清楚的内容，
# 所以两者可以分开设。默认都是 high。界面上也能改，改了会写进 settings.json。
# LEARN_AGENT_REASONING_PLANNER=high
# LEARN_AGENT_REASONING_TUTOR=high

# thinking 字段的 wire 形态：auto | deepseek | openai | none
# auto 会按 baseUrl / 模型名推断（含 deepseek 就走 DeepSeek 形态）。
# 某些兼容服务既不认 DeepSeek 的 thinking 字段也不认 reasoning_effort 时，设为 none。
# LEARN_AGENT_THINKING_FORMAT=auto

# 单次回复的输出上限。默认 32768。
# 开启 thinking 的模型（DeepSeek V4、Claude 扩展思考）会先花掉大量 token 思考，
# 给小了会出现「请求成功但模型没说话」。除非确有必要，不要调到 8192 以下。
# LEARN_AGENT_MAX_TOKENS=32768
